[window]
width = 580
height = 520
anchor = center
margin_top = 0
margin_bottom = 0
margin_left = 0
margin_right = 0

[style]
theme = default

[behavior]
max_items = 0
close_on_select = true
notify_on_copy = false
vim_mode = false
max_pinned = 20

[keybinds]
# Plain letters never trigger actions outside vim mode: they type into search.
# In vim mode p / u / dd pin, unpin and delete.
select = Return Enter
delete = Delete
pin = Ctrl+p
unpin = Ctrl+Shift+u
clear_search = Ctrl+u
close = Escape
next = Down Tab
prev = Up Shift+Tab
page_down = Page_Down
page_up = Page_Up
first = Home
last = End
tab_switch = Ctrl+Tab Alt+Tab
